---
import { BrevwickIsland } from '../components/BrevwickIsland';

interface Props {
  title?: string;
}

const { title = 'Brevwick — Astro example' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <BrevwickIsland client:load />
  </body>
</html>

<style is:global>
  body {
    margin: 0;
    font-family:
      system-ui,
      -apple-system,
      'Segoe UI',
      Roboto,
      sans-serif;
  }
</style>
