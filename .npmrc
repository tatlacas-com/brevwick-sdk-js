# Hoist transitive dependencies to the workspace root `node_modules`. Required
# for `examples/react-native` to bundle under Metro: pnpm's strict isolation
# would otherwise leave Expo / React Native runtime helpers (expo-modules-core,
# @react-native/virtualized-lists, invariant, lodash, ...) inside the
# content-addressed `.pnpm/` store where Metro's `nodeModulesPaths` whitelist
# (kept tight to prevent dual react-native versions across the monorepo) cannot
# reach them. The SDK packages declare every runtime dep in their own
# `package.json`, so hoisting cannot leak undeclared imports into the published
# bundles — tsup only inlines declared deps and CI runs the full type-check
# gauntlet against the workspace install.
shamefully-hoist=true
