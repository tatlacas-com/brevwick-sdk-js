node_modules/
dist/
coverage/
*.log
.env
.DS_Store
.idea/
.vscode/
*.tsbuildinfo
*.tgz
.svelte-kit/
build/

# Local-only consumer sync scripts (tarball build + install into a sibling app).
scripts/sync-*.sh

# Playwright run artefacts — `test-results/` is per-spec failure dumps,
# `playwright-report/` is the HTML reporter output. Both are reproducible
# from a re-run and would just inflate diffs / repo size if committed.
test-results/
playwright-report/

# Expo CLI metadata — autogenerated under each example app on `expo start`.
# Includes a per-machine `devices.json` (last-used emulator IDs) and a
# `README.md` that just describes the dir. None of it belongs in source.
.expo/

# Internal initiative-planning docs. Used by maintainers when bundling
# multi-issue work into a worktree-per-PR layout; reference private
# sibling repos and PR numbers and are not useful to public consumers.
*-worktree.md
worktrees-*.md

# Local PR-review scratchpads written by the review agents. Internal
# only — checked-in copies leak private repo references and reviewer
# notes that belong in the PR thread, not the SDK tree.
notes/reviews/
